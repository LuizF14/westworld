       "  'metrics': ['SBK'],\n",
       "  'npc_name': '冯宝宝'},\n",
       " '35a4d71e106611efa94952540018468a': {'messages': [{'role': 'user',\n",
       "    'text': '宝儿姐，谢谢你陪我来看祭奠父母，我父母是2019年意外去世的，像一场梦一样。'},\n",
